#!/bin/bash
#  brudnopis - simple note taking script
#  Author: Pwlcz
#  It started as alias brudnopis="vim ~/brudnopis.txt", but evolved into this monstorosity.
#  Config file is stored in ${HOME}/.config/brudnopis.conf
#  Completion script for zsh is generated in ${HOME}/.zsh/completions/_brudnopis
set -euo pipefail

VERSION='0.2.1'

search_date=''
grep_pattern=''
search_mode='exact'

CONF_FILE="${HOME}/.config/brudnopis.conf"
if [[ -f "${CONF_FILE}" ]]; then
  # shellcheck source=${HOME}/.config/brudnopis.conf
  source "${CONF_FILE}"
fi

#######################################
# Generate default config file
# Globals:
#   None
# Arguments:
#   None
# Outputs:
#   Default config file to ~/.config/brudnopis.conf
# Returns:
#   0 on success, non-zero on failure
#######################################
function restore_defaults() {
  mkdir -p "${HOME}/.config"
  cat > "${CONF_FILE}" << 'EOF'
# Default configuration for brudnopis
NOTE_FILE="${NOTE_FILE:=brudnopis.txt}"

readonly EDITOR="${EDITOR:=vim}"
readonly EDITOR_ARGS="${EDITOR_ARGS:-}"
readonly GENERAL_NOTE_FILE="${GENERAL_NOTE_FILE:=${HOME}/Dokumenty/brudnopis_general.txt}"
readonly DATE_FORMAT="+%Y-%m-%d %A %R:%S"

note_dir="${PWD}"
repo_dir=$(git rev-parse --show-toplevel 2>/dev/null || echo '')

flag_force_local=false
flag_use_global=false
EOF
}

#######################################
# Function to display help message
# Globals:
#   None
# Arguments:
#   None
# Outputs:
#   Help message to stdout
# Returns:
#   0 on success, non-zero on failure
#######################################
function help() {
  cat << EOF
Open txt file for temp notes. To use preferred editor edit the script config file.

Usage: brudnopis [options] [quick note text]
Any non-option arguments are treated as quick note text to be appended to the note file.

Options:
  -h, --help                Display this message.
  -v, --version             Show script version.
  -g, --global              Open general note in ${GENERAL_NOTE_FILE:-==CONFIG FILE MISSING==}
  -l, --local               Force opening note in current dir
  -r, --repo                Config notes in git repo
  -f, --find                Find all notes in current dir and subdirs
  --grep PATTERN            Search note content by text (case-insensitive)
  --compleat                Generate zsh completion script
  --print-variables         Print current program variables
  --edit-variables          Edit program variables in ${CONF_FILE}
  --default                 Restore default configuration in ${CONF_FILE}
  -s, --search DATE [MODE]  Search notes by date. MODE: exact, newer, older (default: exact)
                            DATE can be: 2024-06-15, "June 15, 2024", today, yesterday, "3 days ago"
                            Example: brudnopis --search 2024-06-15 exact
EOF
}

#######################################
# Function to generate zsh completion script
# Globals:
#   None
# Arguments:
#   None
# Outputs:
#   Zsh completion script to ~/.zsh/completions/_brudnopis
# Returns:
#   0 on success, non-zero on failure
#######################################
function compleat() {
  local comp_dir="${HOME}/.zsh/completions"
  mkdir -p "${comp_dir}"
  cat > "${comp_dir}/_brudnopis" << 'EOF'
#compdef brudnopis

_brudnopis() {
  local -a args
  args=(
    '(-h --help)'{-h,--help}'[Display help message]'
    '(-v --version)'{-v,--version}'[Show script version]'
    '(-g --global)'{-g,--global}'[Open general note]'
    '(-l --local)'{-l,--local}'[Force opening note in current dir]'
    '(-r --repo)'{-r,--repo}'[Config notes in git repo]'
    '(-f --find)'{-f,--find}'[Find all notes recursively]'
    '(-s --search)'{-s,--search}'[Search notes by date]:date string: :(exact newer older)'
    '--compleat[Generate completion script]'
    '--print-variables[Print debug variables]'
    '--edit-variables[Edit config file]'
    '--default[Restore defaults]'
    '*:quick note:_default'
  )
  _arguments "${args[@]}"
}
_brudnopis "$@"
EOF
  local zshrc="${HOME}/.zshrc"
  # shellcheck disable=SC2016
  if ! grep -Eq 'fpath=\(.*\~/\.zsh/completions.*\$fpath\)' "${zshrc}"; then
    echo "Adding completions directory to fpath in ${zshrc}..."
    # Prepend the fpath line to the TOP of ~/.zshrc
    sed -i.bak '1s;^;fpath=(~/.zsh/completions $fpath)\n;' "${zshrc}"
  fi

  if ! grep -Eq '\bcompinit\b' "${zshrc}"; then
    echo "No compinit found in ${zshrc}. Adding it now..."
    echo 'autoload -Uz compinit && compinit' >> "${zshrc}"
    echo "Updated ${zshrc} to load completions. Old file backed up as ${zshrc}.bak"
  fi
  echo "Completion script written to ${comp_dir}/_brudnopis"
  echo "Please restart your shell or run: source ~/.zshrc"
}

#######################################
# Helper function to find every brudnopis.txt in subdirs 
# Globals:
#   note_dir
# Arguments:
#   $1 (optional) - directory to search from; defaults to PWD
# Outputs:
#   find command output with file details
# Returns:
#   0 if files found or directory exists, 1 if directory not accessible
#######################################
function find_notes() {
  local dir="${1:-${note_dir}}"
  if [[ ! -d "${dir}" ]]; then
    echo "Error: Directory '${dir}' does not exist or is not accessible" >&2
    return 1
  fi
  find "${dir}" -type f -name "${NOTE_FILE}" -exec ls -lh {} + 2>/dev/null || {
    echo "Warning: Failed to list some note files in ${dir}" >&2
    return 1
  }
}

#######################################
# Helper function to find entries matching provided date
# Globals:
#   NOTE_FILE
# Arguments:
#   $1 - date_lookup: date string to search for (required)
#   $2 - mode: search mode "exact", "newer", or "older" (defaults to "exact")
# Outputs:
#   all notes matching the date criteria, or error message
# Returns:
#   0 on success, 1 on date parse error or file not found
#######################################
function search_date_in_brudnopis() {
    if [[ -z "${1:-}" ]]; then
      echo "Error: search_date_in_brudnopis requires a date argument" >&2
      return 1
    fi
    if [[ ! -f "${NOTE_FILE}" ]]; then
      echo "Error: Note file '${NOTE_FILE}' does not exist" >&2
      return 1
    fi
    
    local raw_target="$1"
    local mode="${2:-exact}"                  # "exact", "newer", "older"
    local file="${NOTE_FILE}"

    if ! target=$(date -d "${raw_target//./-}" +%Y-%m-%d 2>/dev/null); then
        echo "Error: Could not understand date '${raw_target}'" >&2
        return 1
    fi
    echo "Searching for date: ${raw_target} (parsed as ${target}) with mode: ${mode} in file: ${file}"
    awk -v target="${target}" -v mode="${mode}" '
    /^[0-9]{4}\-[0-9]{2}\-[0-9]{2}/ {
        current_date = $1

        should_print = 1
        if (mode == "exact") {
            should_print = (current_date == target)
        }
        else if (mode == "newer") {
            should_print = (current_date >= target)
        }
        else if (mode == "older") {
            should_print = (current_date < target)
        }
    }

    should_print { print }
    ' "${file}"
}

#######################################
# Helper function to interactively clean up multiple NOTE_FILE in git repo
# Merges multiple note files and adds to .gitignore
# Globals:
#   NOTE_FILE, repo_dir
# Arguments:
#   None
# Outputs:
#   User prompts and status messages
# Returns:
#   0 on success, 1 if not in a git repository
#######################################
function repo_config() {
  if [[ -z "${repo_dir}" ]]; then
    echo "Error: Not in a git repository." >&2
    return 1
  fi
    printf "Configuring notes in git repo: %s\n" "${repo_dir}"

    local gitignore_file="${repo_dir}/.gitignore"

    if [[ ! -f "${gitignore_file}" ]] || ! grep -q "${NOTE_FILE}" "${gitignore_file}"; then
      read -rp "Add ${NOTE_FILE} to .gitignore? [y/N]: " gitignore_choice
      if [[ "${gitignore_choice}" == [yY] ]]; then
        if echo -e "\n${NOTE_FILE}" >> "${repo_dir}/.gitignore"; then
          echo "Added ${NOTE_FILE} to .gitignore"
        else
          echo "Error: Failed to add ${NOTE_FILE} to .gitignore" >&2
          return 1
        fi
      else
        echo "Skipping adding to .gitignore."
      fi
    else
      echo "${NOTE_FILE} is already in .gitignore"
    fi

    echo "Note(s) in repo:"
    if ! files_ls=$(find_notes "${repo_dir}" 2>/dev/null); then
      echo "No notes in ${repo_dir}" >&2
      return 0
    fi
    echo "${files_ls}"
    files_count=$(echo "${files_ls}" | wc -l)

    if (( files_count > 1 )); then
      echo "There are ${files_count} notes in the repo."
      read -rp "Do you want to merge them into one note? [y/N]: " merge_choice
      if [[ "${merge_choice}" == [yY] ]]; then
        echo "Merging notes..."
        if ! find "${repo_dir}" -type f -name "${NOTE_FILE}" ! -path "${repo_dir}/${NOTE_FILE}" | while read -r file; do
        {
          echo "=== From: $(realpath --relative-to="${repo_dir}" "${file}") ==="
          cat "${file}" || echo "Error: Failed to read ${file}" >&2
          echo ""
        } >> "${repo_dir}/${NOTE_FILE}"
        done; then
          echo "Warning: Some files failed to merge" >&2
        fi
        echo "Merged notes into ${repo_dir}/${NOTE_FILE}"
        echo "Removing old notes..."
        if ! find "${repo_dir}" -type f -name "${NOTE_FILE}" ! -path "${repo_dir}/${NOTE_FILE}" -exec rm {} + 2>/dev/null; then
          echo "Error: Failed to remove all old note files" >&2
          return 1
        fi
        echo "Old notes removed."
      else
        echo "Merge cancelled."
      fi
    fi
}

#######################################
# Search note file content by text pattern (case-insensitive)
# Globals:
#   NOTE_FILE
# Arguments:
#   $1 - grep_pattern: text pattern to search for (required)
# Outputs:
#   matching lines with line numbers, or error message\n# Returns:\n#   0 on success, 1 if pattern not found or file not found
#######################################
function search_text_in_brudnopis() {
    if [[ -z "${1:-}" ]]; then
      echo "Error: search_text_in_brudnopis requires a pattern argument" >&2
      return 1
    fi
    if [[ ! -f "${NOTE_FILE}" ]]; then
      echo "Error: Note file '${NOTE_FILE}' does not exist" >&2
      return 1
    fi
    
    local pattern="$1"
    local file="${NOTE_FILE}"
    
    echo "Searching for pattern: '${pattern}' in file: ${file}" >&2
    if grep -in "${pattern}" "${file}"; then
      return 0
    else
      echo "No matches found for pattern: '${pattern}'" >&2
      return 1
    fi
}

#######################################
# Helper function to display config file
# Globals:
#   CONF_FILE
# Arguments:
#   None
# Outputs:
#   cat CONF_FILE to stdout
# Returns:
#   0 on success, non-zero on failure
#######################################
function print_vars() {
  echo "Variables are stored in ${CONF_FILE}"
  cat "${CONF_FILE}"
}

#######################################
# Creates or removes a timestamp in the note file
# Globals:
#   NOTE_FILE, DATE_FORMAT
# Arguments:
#   $1 - mode: "add" to add timestamp, "rm" to remove last timestamp
# Outputs:
#   Status messages, or error message if invalid mode
# Returns:
#   0 on success, 1 on failure or invalid mode
#######################################
function timestamp() {
  if [[ ! -f "${NOTE_FILE}" ]]; then
    if ! touch "${NOTE_FILE}" 2>/dev/null; then
      echo "Error: Failed to create note file '${NOTE_FILE}'" >&2
      return 1
    fi
  fi
  
  local mode="${1:-}"
  case "${mode}" in
    add)
      local last_line=''
      last_line=$(tail -n 1 "${NOTE_FILE}" 2>/dev/null || echo '')
      {
        if [[ -n "${last_line}" ]]; then
          echo ''
        fi
        date "${DATE_FORMAT}" || echo "Error: date command failed" >&2
        echo ''
      } >> "${NOTE_FILE}" || {
        echo "Error: Failed to write timestamp to '${NOTE_FILE}'" >&2
        return 1
      }
    ;;
    rm)
      if ! head -n -2 "${NOTE_FILE}" > "${NOTE_FILE}.tmp" || ! mv "${NOTE_FILE}.tmp" "${NOTE_FILE}"; then
        echo "Error: Failed to remove timestamp from '${NOTE_FILE}'" >&2
        rm -f "${NOTE_FILE}.tmp"
        return 1
      fi
    ;;
    *) 
      echo "Error: Invalid timestamp mode '${mode}'. Must be 'add' or 'rm'" >&2
      return 1
    ;;
  esac
}

#######################################
# Helper function to append text to NOTE_FILE
# Globals:
#   NOTE_FILE
# Arguments:
#   $* - text to append (all arguments concatenated)
# Outputs:
#   Error message if file write fails
# Returns:
#   0 on success, 1 if no text or write fails
#######################################
function quicknote() {
  local text="$*"
  if [[ -z "${text}" ]]; then
    echo "Warning: No text provided to quicknote" >&2
    return 1
  fi
  if ! echo "${text}" >> "${NOTE_FILE}" 2>/dev/null; then
    echo "Error: Failed to write to note file '${NOTE_FILE}'" >&2
    return 1
  fi
}

#######################################
# Open the note file in the configured editor
# Automatically enables syntax highlighting for timestamps in vim/nvim
# Supports vim, nvim and other editors with graceful fallback
# Globals:
#   EDITOR, EDITOR_ARGS, NOTE_FILE
# Arguments:
#   None
# Outputs:
#   Editor session output, or error message if editor not found
# Returns:
#   editor exit status, or 1 if editor command fails
#######################################
function open_editor() {
  if ! command -v "${EDITOR%% *}" &> /dev/null; then
    echo "Error: Editor '${EDITOR}' not found or not executable" >&2
    return 1
  fi
  
  local editor_bin="${EDITOR%% *}"
  local editor_name="${editor_bin##*/}"
  local editor_args=()

  # Configure editor-specific arguments
  case "${editor_name}" in
    vim | nvim)
      editor_args+=("+syntax enable")
      editor_args+=("+syntax match BrudnopisTimestamp /^\\d\\{4\\}-\\d\\{2\\}-\\d\\{2\\} .*$/")
      editor_args+=("+highlight BrudnopisTimestamp ctermfg=Green guifg=Green")
      editor_args+=("+syntax match BrudnopisTodo /TODO/")
      editor_args+=("+highlight BrudnopisTodo ctermfg=Black ctermbg=Yellow guifg=Black guibg=Yellow cterm=bold gui=bold")
      if [[ -n "${EDITOR_ARGS}" ]]; then
        editor_args+=("${EDITOR_ARGS}")
      else
        editor_args+=("+")
      fi
      ;;
    *)
      # Generic editor support - just pass EDITOR_ARGS if set
      if [[ -n "${EDITOR_ARGS}" ]]; then
        editor_args+=("${EDITOR_ARGS}")
      fi
      ;;
  esac

  editor_args+=("${NOTE_FILE}")
  ${EDITOR} "${editor_args[@]}" || {
    echo "Error: Editor exited with status $?" >&2
    return 1
  }
}

#######################################
# Function to edit NOTE_FILE
# Globals:
#   CONF_FILE
#   NOTE_FILE
# Arguments:
#   None
# Outputs:
#   Help message to stdout
# Returns:
#   0 on success, non-zero on failure
#######################################
function main() {
  if [[ "$*" != "--default" && ! -f ${CONF_FILE} ]]; then
    read -rp "Configuration file not found. Create default config at ${CONF_FILE}? [Y/n]: " create_conf_choice
    if [[ "${create_conf_choice}" == [yY] || -z "${create_conf_choice}" ]]; then
      restore_defaults
      source "${CONF_FILE}"
    else
      echo "Cannot proceed without configuration file. Exiting." >&2
      exit 1
    fi
  fi

  if ! PARSED_ARGS=$(getopt --name brudnopis --options hrlgfs:v \
        --longoptions help,repo,local,global,find,default,search:,grep:,edit-variables,print-variables,compleat,version -- "$@"); then
    help >&2
    exit 1
  fi
  eval set -- "${PARSED_ARGS}"
  
  while true; do
    case "$1" in 
      -h | --help)
        help
        exit 0
        ;;
      -v | --version)
        echo "${VERSION}"
        exit 0
        ;;
      -g | --global)
        flag_use_global=true
        shift
        ;;
      -l | --local)
        flag_force_local=true
        shift
        ;;
      -r | --repo)
        repo_config
        exit 0
        ;;
      -f | --find)
        find_notes
        exit 0
        ;;
      --default)
        restore_defaults
        print_vars
        exit 0
        ;;
      -s | --search)
        shift
        search_date="$1"
        if [[ -z "${search_date:-}" ]]; then
          echo "Error: --search requires a date." >&2
          exit 1
        fi
        shift
        if [[ "$1" == "exact" || "$1" == "newer" || "$1" == "older" ]]; then
          search_mode="$1"
          shift
        else
          search_mode="exact"
        fi
        ;;
      --grep)
        shift
        grep_pattern="$1"
        if [[ -z "${grep_pattern:-}" ]]; then
          echo "Error: --grep requires a search pattern." >&2
          exit 1
        fi
        shift
        ;;
      --print-variables)
        print_vars
        exit 0
        ;;
      --edit-variables)
        "${EDITOR}" "${EDITOR_ARGS}" "${CONF_FILE}"
        exit 0
        ;;
      --compleat)
        compleat
        exit 0
        ;;
      --)
        shift
        break
        ;;
      *)
        echo "Unrecognized option: $1"
        shift
        ;;
    esac
  done

  if [[ "${flag_use_global}" == true && "${flag_force_local}" == true ]]; then
    echo "Cannot use both --global and --local flags." >&2
    exit 1
  fi

  if [[ "${flag_force_local}" == true ]];  then                                  #force note in PWD
    NOTE_FILE="${PWD}/${NOTE_FILE}"

  elif [[ "${note_dir}" == "${HOME}" || "${flag_use_global}" == true ]]; then    #general note  
    NOTE_FILE="${GENERAL_NOTE_FILE}"

  elif [[ -n "${repo_dir}" ]]; then                                              #note in git repo
    NOTE_FILE="${repo_dir}/${NOTE_FILE}"

  else                                                                           #note in PWD
    NOTE_FILE="${note_dir}/${NOTE_FILE}"

  fi

  if [[ -n "${search_date:-}" ]]; then
    search_date_in_brudnopis "${search_date}" "${search_mode:-exact}"
    exit 0
  fi

  if [[ -n "${grep_pattern:-}" ]]; then
    search_text_in_brudnopis "${grep_pattern}"
    exit 0
  fi

  if [[ -n "$*" ]]; then
    timestamp add
    quicknote "$*"
    exit 0
  fi

  timestamp add
  md5hash=$(md5sum "${NOTE_FILE}" | awk '{print $1}')
  
  open_editor
  
  # if no changes made, remove timestamp
  new_md5hash=$(md5sum "${NOTE_FILE}" | awk '{print $1}')
  if [[ "${md5hash}" == "${new_md5hash}" ]]; then
    timestamp rm
    echo "${NOTE_FILE} unchanged."
  fi
}

main "$@"