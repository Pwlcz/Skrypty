Vagrant.configure("2") do |config|
  # Universally disable the default synced folder to prevent rsync/libvirt crashes
  config.vm.synced_folder ".", "/vagrant", disabled: true

  # Set sane defaults for the libvirt provider
  config.vm.provider :libvirt do |libvirt|
    libvirt.driver = "kvm"
    libvirt.connect_via_ssh = false
    libvirt.username = "root"

    libvirt.memory = 1024
    libvirt.cpus = 1
  end
end