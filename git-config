#!/bin/bash
# I wont remember to configure it (again).
set -euo pipefail

VERSION='0.1.1'

function help() {
  cat << EOF
Interactively set basic git local or global config. With optional setup for handling gpg.

Usage: git-config [Options]

Options:
  -h,   --help        display this message
  -v,   --version     check script version
  -k,   --pub-key     alias to ssh-add -l
  -g,   --global      configure global settings

Minor problems troubleshoot:
-- If you have Kleopatra installed, Settings → Configure Kleopatra → GnuPG System → (look for logging/debug). Set log level to none and clear the file path (https://bbs.archlinux.org/viewtopic.php?id=296399)

-- Copy pinentry-wrapper script to avoid popups when working in terminal.

-- Check $HOME/.gnupg/gpg-agent.conf for possible issues
EOF
}

function echo_error() {
  echo -e "\e[31mError: $*\e[0m" >&2 # Red
}

function echo_ok() {
  echo -e "\e[1;32m$*\e[0m" # Bold Green  
}

function echo_step() {
  local ARROW="\e[34m==>\e[0m" # Blue
  echo -e "${ARROW} \e[1m$*\e[0m" # Bold 
}

function detect_shell_rc_file() {
  local shell_name=""
  local parent_shell=""

  if [[ -n "${SHELL:-}" ]]; then
    shell_name="$(basename "$SHELL")"
  fi

  # like that will ever happen
  if [[ -z "$shell_name" ]]; then
    parent_shell="$(ps -p "${PPID:-$$}" -o comm= 2>/dev/null | tr -d '[:space:]')"
    shell_name="$(basename "$parent_shell")"
  fi

  case "$shell_name" in
    zsh)
      echo "$HOME/.zshrc"
      ;;
    bash)
      echo "$HOME/.bashrc"
      ;;
    fish)
      echo "$HOME/.config/fish/config.fish"
      ;;
    *)
      if [[ -f "$HOME/.zshrc" ]]; then
        echo "$HOME/.zshrc"
      else
        echo "$HOME/.bashrc"
      fi
      ;;
  esac
}

function append_gpg_ssh_setup() {
  local shellrc="$1"
  local marker="# >>> git-config gpg ssh >>>"
  local agent_conf="$HOME/.gnupg/gpg-agent.conf"

  mkdir -p "$HOME/.gnupg"
  if ! grep -Fq "enable-ssh-support" "$agent_conf" 2>/dev/null; then
    echo "enable-ssh-support" >> "$agent_conf"
  fi

  # Force terminal pinentry (no GUI popup)
  if ! grep -q "^pinentry-program" "$agent_conf" 2>/dev/null; then
    local pinentry_path
    if command -v pinentry-wrapper &>/dev/null; then
      pinentry_path=$(command -v pinentry-wrapper)
    fi

    if [[ -n "${pinentry_path:-}" ]]; then
      echo "pinentry-program $pinentry_path" >> "$agent_conf"
    else
      echo_error "Could not find pinentry-wrapper. The default password popup window will ALWAYS appear."
      read -rp "Do you want to create the simple wrapper now? [Y/n]: " create_wrapper
      if [[ $create_wrapper != [Nn] ]]; then
        pinentry_path="$HOME/bin/pinentry-wrapper"
        mkdir -p "$(dirname "${pinentry_path}")"
        cat > "$pinentry_path" << 'EOF'
#!/bin/bash

# If the terminal explicitly told us to use a TTY, use the console pinentry
# Change sequence if you prefer the other one
if [ "$PINENTRY_USER_DATA" = "USE_TTY" ]; then
    if command -v pinentry-curses &>/dev/null; then
        exec pinentry-curses "$@"
    elif command -v pinentry-tty &>/dev/null; then
        exec pinentry-tty "$@"
    fi
fi

# Fallback for Kleopatra and desktop environments (no terminal attached)
if command -v pinentry-qt &>/dev/null; then
    exec pinentry-qt "$@"
elif command -v pinentry-gnome3 &>/dev/null; then
    exec pinentry-gnome3 "$@"
else
    # System default GUI if specific ones aren't found
    exec pinentry "$@"
fi
EOF
      chmod +x "$pinentry_path"
      echo "pinentry-program $pinentry_path" >> "$agent_conf"
      echo_ok "Created wrapper in $pinentry_path"
      fi
    fi
  else
    echo "Make sure pinentry-program in $agent_conf is the one you want!"
  fi
  
  #Force restart
  gpgconf --kill gpg-agent

  if [[ -z "$shellrc" ]]; then
    echo_error "Could not determine shell startup file."
    return 1
  fi

  mkdir -p "$(dirname "$shellrc")"
  touch "$shellrc"

  if ! grep -Fq "$marker" "$shellrc" 2>/dev/null; then
    local tmp_shellrc
    tmp_shellrc="$(mktemp)"
    {
      cat <<'EOF'
# >>> git-config gpg ssh >>>
unset SSH_AGENT_PID
if [ "${gnupg_SSH_AUTH_SOCK_by:-0}" -ne $$ ]; then
  export SSH_AUTH_SOCK="$(gpgconf --list-dirs agent-ssh-socket)"
fi

# Update the TTY and tell the pinentry-wrapper to use the console prompt
_CUR_TTY=$(tty 2>/dev/null)
case "$_CUR_TTY" in
  /dev/*)
    # this line should be before p10k sourcing (if present)
    export GPG_TTY="$_CUR_TTY"
    export PINENTRY_USER_DATA="USE_TTY"
    gpg-connect-agent updatestartuptty /bye &>/dev/null
    ;;
esac
unset _CUR_TTY
# <<< git-config gpg ssh <<<
EOF
      if [[ -s "$shellrc" ]]; then
        echo ''
        cat "$shellrc"
      fi
    } > "$tmp_shellrc"
    mv "$shellrc" "${shellrc}.old" && echo "Previous $shellrc saved to ${shellrc}.old" 
    mv "$tmp_shellrc" "$shellrc"
  fi
}

function main() {
  repo_dir=$(git rev-parse --is-inside-work-tree 2>/dev/null || echo '')
  config_file_flag="--local"
  config_file="Local"

  if ! PARSED_ARGS=$(getopt --name git-config --options hvkg \
        --longoptions help,version,pub-key,global -- "$@"); then
    help >&2
    exit 1
  fi
  eval set -- "${PARSED_ARGS}"
  
  while true; do
    case "$1" in 
      -h | --help)
        help
        exit 0
        ;;
      -v | --version)
        echo "${VERSION}"
        exit 0
        ;;
      -k | --pub-key)
        ssh-add -l
        exit 0
	      ;;
      -g | --global)
        config_file_flag="--global"
        config_file="Global"
        break
        ;;
      --)
        shift
        break
        ;;
      *)
        echo "Unrecognized option: $1"
        shift
        ;;
    esac
  done

  if [[ -z "${repo_dir}" && "$config_file_flag" == "--local" ]]; then
    read -rp "Not in a git repository. Do you want to configure Global settings? [Y/n]: " config_global
    if [[ "$config_global" != [nN] ]]; then
      config_file_flag="--global"
      config_file="Global"
    else
      exit 0
    fi
  fi

  # User Details
  echo_step "Configure user identity"
  echo -n "Current Git $config_file " && echo_ok "user.name: $(git config user.name)" 
  read -rp "Enter your Full Name for Git (e.g., John Doe, Leave empty for no changes): " git_name
  if [[ -n "$git_name" ]]; then
    git config "$config_file_flag" user.name "$git_name"
  fi
  echo ''

  echo -n "Current Git $config_file " && echo_ok "user.email: $(git config user.email)"
  read -rp "Enter your Email for Git (e.g., john@example.com, Leave empty for no changes): " git_email
  if [[ -n "$git_email" ]]; then
    git config "$config_file_flag" user.email "$git_email"
  fi
  echo ''

  echo_ok "User identity set"
  echo "$config_file user.name: $(git config user.name)"
  echo "$config_file user.email: $(git config user.email)"
  echo ''

  # default init branch
  echo_step "Configure default init branch"
  echo -n "Current Git $config_file " && echo_ok "init.defaultBranch: $(git config init.defaultBranch)"
  read -rp "Enter preffered initial default branch name (e.g., main, Leave empty for no changes): " git_defaultbranch
  if [[ -n "$git_defaultbranch" ]]; then
    git config "$config_file_flag" init.defaultBranch "$git_defaultbranch"
  fi
  echo_ok "Default $config_file branch set to \"$(git config init.defaultBranch)\"."
  echo ''

  # Commit signing configuration
  echo_step "Configure commit signing"
  current_signkey=$(git config user.signingkey)
  echo -n "Current Git $config_file " && echo_ok "user.signingkey: $current_signkey"
  read -rp "Do you want to enable GPG commit signing? [Y/n]: " enable_signing
  echo ''
  if [[ "$enable_signing" == [nN] ]]; then
    git config "$config_file_flag" commit.gpgsign false
    echo_ok "GPG commit signing disabled."
  else
    echo "List of available GPG keys:"
    gpg --list-secret-keys 2>/dev/null

    declare -A valid_gpg_keys=()
    declare -A key_fingerprints=()
    gpg_keys=()
    sec_seen=false

    while IFS= read -r line; do
      # GnuPG uses `sec>` for smartcard-backed stubs and `sec ` for normal keys.
      if [[ "$line" =~ ^sec([[:space:]>]) ]]; then
        sec_seen=true
        continue
      fi

      if [[ "$sec_seen" == true ]]; then
        if [[ "$line" =~ ^[[:space:]]+([0-9A-Fa-f]{16,40})[[:space:]]*$ ]]; then
          fingerprint="${BASH_REMATCH[1]}"
          short_key="${fingerprint: -16}"
          gpg_keys+=("$short_key")
          key_fingerprints["${short_key,,}"]="$fingerprint"
          key_fingerprints["${fingerprint,,}"]="$fingerprint"
          valid_gpg_keys["${short_key,,}"]=1
          valid_gpg_keys["${fingerprint,,}"]=1
          sec_seen=false
        fi
      fi
    done < <(gpg --list-secret-keys 2>/dev/null)

    if [[ ${#gpg_keys[@]} -eq 0 ]]; then
      echo "No GPG secret keys found. Please generate one with 'gpg --full-generate-key' and rerun this script."
      exit 1
    fi

    for i in "${!gpg_keys[@]}"; do
      printf "%d) %s\n" $((i + 1)) "${gpg_keys[i]}"
    done

    while true; do
      read -rp "Enter the number of the key to use, or paste a key ID directly (Leave blank if already configured): " gpg_key_id
      if [[ -z "$gpg_key_id" ]]; then
        if [[ -n "$current_signkey" ]]; then
          gpg_key_id="${current_signkey%!}"
        else
          echo_error "No key selected. Please enter a valid selection."
          continue
        fi
      fi

      normalized_key="${gpg_key_id,,}"

      if [[ "$gpg_key_id" =~ ^[0-9]+$ ]]; then
        if (( gpg_key_id >= 1 && gpg_key_id <= ${#gpg_keys[@]} )); then
          selected_short_key="${gpg_keys[gpg_key_id-1]}"
          gpg_key_id="${key_fingerprints[${selected_short_key,,}]}"
          break
        fi
        echo_error "Selection out of range. Please choose a valid number."
        continue
      fi

      if [[ -n "${valid_gpg_keys[$normalized_key]+x}" ]]; then
        gpg_key_id="${key_fingerprints[$normalized_key]}"
        break
      fi

      echo_error "Invalid key selection. Please enter a number from the list or one of the available short IDs/fingerprints."
    done

    git config "$config_file_flag" user.signingkey "${gpg_key_id}!"
    git config "$config_file_flag" commit.gpgsign true
    echo_ok "GPG commit signing enabled with key ID: $gpg_key_id"
  fi
  echo ''

  # Use gpg key for ssh
  echo_step "Change ssh agent socket"
  read -rp 'Do you want to use gpg key for ssh? [Y/n]: ' gpg4ssh
  if [[ "$gpg4ssh" != [nN] ]]; then
    shellrc="$(detect_shell_rc_file)"
    append_gpg_ssh_setup "$shellrc"
    echo_ok "Configured GPG SSH support in $shellrc"
    echo ''
    echo_ok "================================= public ssh key ================================="
    export SSH_AUTH_SOCK="$(gpgconf --list-dirs agent-ssh-socket)"
    ssh-add -l || echo_error "restart terminal to apply user config and run: $ ssh-add -l or this script again"
    echo_ok "================== (ssh-add -l) RESTART TERMINAL TO TAKE EFFECT =================="
  fi
  echo ''

  # OS-Specific Line Ending Configuration (autocrlf)
  echo_step "Configuring autocrlf"
  if [[ "$OSTYPE" == "linux-gnu"* ]] || [[ "$OSTYPE" == "darwin"* ]]; then
    # Linux / macOS
    git config --global core.autocrlf input
    echo "Line endings (autocrlf) configured for Unix (input)."
  elif [[ "$OSTYPE" == "msys" ]] || [[ "$OSTYPE" == "cygwin" ]] || [[ "$OSTYPE" == "win32" ]]; then
    # Windows (Git Bash)
    git config --global core.autocrlf true
    echo "Line endings (autocrlf) configured for Windows (true)."
  else
    echo "OS not definitively recognized. Skipping autocrlf configuration."
  fi
  echo ''

  echo_step "Turning off default pager"
  git config --global core.pager ''
  echo ''

  # Set simple push/pull behavior
  echo_step "Configuring simple Push/Pull behaviors"
  git config --global push.default simple
  git config --global pull.rebase false
  echo ''

  echo_ok "Git current settings:"
  echo_ok "==========================================================="
  git --no-pager config --list
  echo_ok "==========================================================="
}

main "$@"
